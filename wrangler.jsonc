// Cloudflare deploy for icontween.vedjuk.com (decision 022). An assets-only Worker: no Worker code, so
// nothing runs on the server, only static files from the production build (rule 5).
{
  "name": "icontween",
  "compatibility_date": "2026-11-10",
  "assets": {
    // Built by `pnpm build`.
    "directory": "./apps/web/dist",
    // /editor, /prepare, /runtime and any unknown path get index.html with 200; main.tsx
    // picks the page from the path.
    "not_found_handling": "single-page-application",
  },
  // The site's address. A deploy attaches it to the Worker, and Cloudflare creates the one DNS
  // record and certificate for it in the vedjuk.com zone. With a custom domain set, the
  // workers.dev address is off.
  "routes": [{ "pattern": "icontween.vedjuk.com", "custom_domain": true }],
}
