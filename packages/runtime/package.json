{
  "name": "@icontween/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Tiny, dependency-free playback runtime for IconTween animations. Published later as `icontween`.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./bundle": {
      "types": "./scripts/bundle.d.ts",
      "default": "./scripts/bundle.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.js"
  },
  "devDependencies": {
    "@icontween/core": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.0",
    "vite": "^8.3.7"
  }
}
