"/**
 * copy, an animated icon made with IconTween (https://icontween.com).
 *
 * Trigger: click, plays on click.
 * Reduced motion: when the OS asks for less motion, it jumps to each state without moving.
 *
 * Needs the IconTween runtime next to this file: icontween.js and icontween.d.ts.
 *
 * Usage, inside a button so the whole button is the target:
 *   const button = useRef<HTMLButtonElement>(null);
 *   <button ref={button} type="button" aria-label="copy">
 *     <CopyIcon listenOn={button} />
 *   </button>
 */
import { forwardRef, useEffect, useImperativeHandle, useRef } from 'react';
import type { RefObject, SVGProps } from 'react';
import { createPlayer } from './icontween';
import type { Animation, Player, PlayerOptions } from './icontween';

const animation: Animation = {
  id: 'copy',
  name: 'copy',
  purpose: 'feedback',
  viewBox: [0, 0, 24, 24],
  elements: [
    {
      id: 'el-1',
      style: {
        stroke: 'currentColor',
        strokeWidth: 2,
        strokeLinecap: 'round',
        strokeLinejoin: 'round',
        fill: 'none',
      },
    },
    {
      id: 'el-2',
      style: {
        stroke: 'currentColor',
        strokeWidth: 2,
        strokeLinecap: 'round',
        strokeLinejoin: 'round',
        fill: 'none',
      },
    },
  ],
  states: [
    {
      id: 'A',
      elements: {
        'el-1': {
          segments: [
            { cmd: 'M', x: 10, y: 8 },
            { cmd: 'L', x: 20, y: 8 },
            { cmd: 'C', x1: 21.105, y1: 8, x2: 22, y2: 8.895, x: 22, y: 10 },
            { cmd: 'L', x: 22, y: 20 },
            { cmd: 'C', x1: 22, y1: 21.105, x2: 21.105, y2: 22, x: 20, y: 22 },
            { cmd: 'L', x: 10, y: 22 },
            { cmd: 'C', x1: 8.895, y1: 22, x2: 8, y2: 21.105, x: 8, y: 20 },
            { cmd: 'L', x: 8, y: 10 },
            { cmd: 'C', x1: 8, y1: 8.895, x2: 8.895, y2: 8, x: 10, y: 8 },
            { cmd: 'Z' },
          ],
          transform: {
            translateX: 0,
            translateY: 0,
            rotate: 0,
            scale: 1,
            originX: 15,
            originY: 15,
          },
          opacity: 1,
          draw: { start: 0, end: 1 },
        },
        'el-2': {
          segments: [
            { cmd: 'M', x: 4, y: 16 },
            { cmd: 'C', x1: 2.9, y1: 16, x2: 2, y2: 15.1, x: 2, y: 14 },
            { cmd: 'L', x: 2, y: 4 },
            { cmd: 'C', x1: 2, y1: 2.9, x2: 2.9, y2: 2, x: 4, y: 2 },
            { cmd: 'L', x: 14, y: 2 },
            { cmd: 'C', x1: 15.1, y1: 2, x2: 16, y2: 2.9, x: 16, y: 4 },
          ],
          transform: { translateX: 0, translateY: 0, rotate: 0, scale: 1, originX: 9, originY: 9 },
          opacity: 1,
          draw: { start: 0, end: 1 },
        },
      },
    },
    {
      id: 'B',
      elements: {
        'el-1': {
          segments: [
            { cmd: 'M', x: 4, y: 12 },
            { cmd: 'L', x: 9, y: 17 },
            { cmd: 'C', x1: 9, y1: 17, x2: 9, y2: 17, x: 9, y: 17 },
            { cmd: 'L', x: 20, y: 6 },
            { cmd: 'C', x1: 20, y1: 6, x2: 20, y2: 6, x: 20, y: 6 },
            { cmd: 'L', x: 9, y: 17 },
            { cmd: 'C', x1: 9, y1: 17, x2: 9, y2: 17, x: 9, y: 17 },
            { cmd: 'L', x: 4, y: 12 },
            { cmd: 'C', x1: 4, y1: 12, x2: 4, y2: 12, x: 4, y: 12 },
            { cmd: 'Z' },
          ],
          transform: {
            translateX: 0,
            translateY: 0,
            rotate: 0,
            scale: 1,
            originX: 15,
            originY: 15,
          },
          opacity: 1,
          draw: { start: 0, end: 1 },
        },
        'el-2': {
          segments: [
            { cmd: 'M', x: 4, y: 16 },
            { cmd: 'C', x1: 2.9, y1: 16, x2: 2, y2: 15.1, x: 2, y: 14 },
            { cmd: 'L', x: 2, y: 4 },
            { cmd: 'C', x1: 2, y1: 2.9, x2: 2.9, y2: 2, x: 4, y: 2 },
            { cmd: 'L', x: 14, y: 2 },
            { cmd: 'C', x1: 15.1, y1: 2, x2: 16, y2: 2.9, x: 16, y: 4 },
          ],
          transform: { translateX: 0, translateY: 0, rotate: 0, scale: 1, originX: 9, originY: 9 },
          opacity: 0,
          draw: { start: 0, end: 1 },
        },
      },
    },
  ],
  sequence: {
    steps: [
      {
        from: 'A',
        to: 'B',
        duration: 250,
        easing: { type: 'cubic-bezier', x1: 0.3, y1: 0, x2: 0, y2: 1 },
      },
      {
        from: 'B',
        to: 'A',
        duration: 250,
        easing: { type: 'cubic-bezier', x1: 0.3, y1: 0, x2: 0, y2: 1 },
        delays: { 'el-1': 1000, 'el-2': 1000 },
      },
    ],
    repeat: 'once',
  },
  trigger: { type: 'click' },
  reducedMotion: { mode: 'instant' },
};

/** Plays the icon from code, through \`ref\`. */
export interface CopyIconHandle {
  play(): void;
  reverse(): void;
  toggle(): void;
  stop(): void;
  /** Jumps to a state without animating. */
  setState(state: 'A' | 'B'): void;
}

export interface CopyIconProps extends Omit<SVGProps<SVGSVGElement>, 'ref'> {
  /** Width and height. Default 24. */
  size?: number | string;
  /** What starts the animation. Default 'click'. 'manual' plays only through \`ref\`. */
  trigger?: PlayerOptions['trigger'];
  /** Element that listens for the trigger, such as the button around the icon. Default: the icon. */
  listenOn?: RefObject<Element | null>;
  /** 'auto' (default) follows the OS setting, prefers-reduced-motion. */
  reducedMotion?: PlayerOptions['reducedMotion'];
}

export const CopyIcon = forwardRef<CopyIconHandle, CopyIconProps>(function CopyIcon(
  { size = 24, trigger, listenOn, reducedMotion, ...props },
  ref,
) {
  const svg = useRef<SVGSVGElement>(null);
  const player = useRef<Player | null>(null);

  useEffect(() => {
    if (!svg.current) return;
    const current = createPlayer(svg.current, animation, {
      trigger,
      listenOn: listenOn?.current ?? undefined,
      reducedMotion,
    });
    player.current = current;
    return () => {
      current.destroy();
      player.current = null;
    };
  }, [trigger, listenOn, reducedMotion]);

  useImperativeHandle(
    ref,
    () => ({
      play: () => player.current?.play(),
      reverse: () => player.current?.reverse(),
      toggle: () => player.current?.toggle(),
      stop: () => player.current?.stop(),
      setState: (state) => player.current?.setState(state),
    }),
    [],
  );

  return (
    <svg
      ref={svg}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
      {...props}
    >
      <path
        data-icontween-element="el-1"
        d="M10 8 L20 8 C21.105 8 22 8.895 22 10 L22 20 C22 21.105 21.105 22 20 22 L10 22 C8.895 22 8 21.105 8 20 L8 10 C8 8.895 8.895 8 10 8 Z"
        fill="none"
        stroke="currentColor"
        strokeWidth={2}
        strokeLinecap="round"
        strokeLinejoin="round"
      />
      <path
        data-icontween-element="el-2"
        d="M4 16 C2.9 16 2 15.1 2 14 L2 4 C2 2.9 2.9 2 4 2 L14 2 C15.1 2 16 2.9 16 4"
        fill="none"
        stroke="currentColor"
        strokeWidth={2}
        strokeLinecap="round"
        strokeLinejoin="round"
      />
    </svg>
  );
});
"
`;

