  <!-- Where a click counts: the whole icon, not only its strokes. -->
  <rect id="copyHit" x="0" y="0" width="24" height="24" fill="none" pointer-events="all" cursor="pointer" />

  <!-- Timers: every animation above starts with one of these. -->
  <rect width="0" height="0" fill="none">
    <animate
      id="copyPlay"
      attributeName="x"
      values="0; 0"
      begin="copyHit.click"
      dur="1500ms"
      restart="whenNotActive"
      fill="freeze"
    />
  </rect>
