"<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
>
  <!--
    copy, an animated icon made with IconTween (https://icontween.com).
    SVG with SMIL animation: no JavaScript needed.
    It plays on click when the SVG is inline in a page. As an <img> it shows its first state.
    Reduced motion: when the OS asks for less motion, it jumps to each state without moving.
  -->
  <style>
    /* Reduced motion: when the OS asks for less motion, the second group shows instead. */
    .copy-reduced {
      display: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .copy-motion {
        display: none;
      }
      .copy-reduced {
        display: inline;
      }
    }
  </style>

  <g class="copy-motion">
    <!-- el-1 -->
    <path
      d="M10 8 L20 8 C21.105 8 22 8.895 22 10 L22 20 C22 21.105 21.105 22 20 22 L10 22 C8.895 22 8 21.105 8 20 L8 10 C8 8.895 8.895 8 10 8 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <animate
        attributeName="d"
        begin="copyPlay.begin"
        dur="1500ms"
        fill="freeze"
        calcMode="spline"
        keyTimes="0; 0.1667; 0.8333; 1"
        keySplines="0.3 0 0 1; 0 0 1 1; 0.3 0 0 1"
        values="
          M10 8 L20 8 C21.105 8 22 8.895 22 10 L22 20 C22 21.105 21.105 22 20 22 L10 22 C8.895 22 8 21.105 8 20 L8 10 C8 8.895 8.895 8 10 8 Z;
