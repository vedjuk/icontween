# Cloudflare static headers. Nothing leaves the browser, so lock the page down.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

# Vite puts a content hash in every file name under /assets, so browsers can keep them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The export preview runs the exported file's inline scripts, so it drops the CSP above and
# sets its own in a <meta> tag (export-preview.html, decision 022). Cloudflare redirects
# /export-preview.html to /export-preview, so the pattern covers both.
/export-preview*
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
